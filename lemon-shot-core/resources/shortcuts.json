{
  "version": 1,
  "notation": "修饰键写成 cmd/ctrl/alt/shift，按键写大写字母、数字或 F1-F12/Space/Enter/Esc/Tab/Up/Down/Left/Right/Delete。mac 的 alt 显示为 Option，Windows 的 cmd 不存在。",
  "global": [
    { "id": "capture",          "mac": "alt+A", "win": "alt+A" },
    { "id": "record",           "mac": "alt+W", "win": "ctrl+alt+W" },
    { "id": "ocr",              "mac": "alt+O", "win": "ctrl+alt+O" },
    { "id": "translate",        "mac": "alt+T", "win": "ctrl+alt+T" },
    { "id": "pinClipboard",     "mac": "alt+S", "win": "ctrl+alt+S" },
    { "id": "pinLibrary",       "mac": "alt+F", "win": "ctrl+alt+F" },
    { "id": "togglePins",       "mac": "alt+H", "win": "ctrl+alt+H" },
    { "id": "captureLastArea",  "mac": "alt+X", "win": "ctrl+alt+X" },
    { "id": "captureWindow",    "mac": "alt+Z", "win": "ctrl+alt+Z" },
    { "id": "captureFullscreen","mac": "alt+Q", "win": "ctrl+alt+Q" },
    { "id": "capturePreset",    "mac": "alt+G", "win": "ctrl+alt+G" },
    { "id": "captureDelayed",   "mac": "alt+D", "win": "ctrl+alt+D" },
    { "id": "captureShell",     "mac": "alt+R", "win": "ctrl+alt+R" },
    { "id": "longshot",         "mac": "",      "win": "" },
    { "id": "colorPicker",      "mac": "",      "win": "" },
    { "id": "recordAudio",      "mac": "alt+E", "win": "ctrl+alt+E" },
    { "id": "recordPause",      "mac": "alt+P", "win": "ctrl+alt+P" },
    { "id": "recordPen",        "mac": "alt+B", "win": "ctrl+alt+B" }
  ],
  "globalNote": "Windows 只有截图用 Alt+A（与 Mac 的 Option+A 同一个物理键位），其余用 Ctrl+Alt：全局占用 Alt+字母 会让所有程序的菜单访问键（Alt+F 文件、Alt+E 编辑等）失效。注册失败（被其他程序占用）时托盘气泡提示并在设置里标红。",
  "capture": [
    { "id": "toolRect",      "key": "1" },
    { "id": "toolEllipse",   "key": "2" },
    { "id": "toolLine",      "key": "3" },
    { "id": "toolArrow",     "key": "4" },
    { "id": "toolPen",       "key": "5" },
    { "id": "toolMosaic",    "key": "6" },
    { "id": "toolText",      "key": "7" },
    { "id": "toolStep",      "key": "8" },
    { "id": "toolHighlight", "key": "9" },
    { "id": "toolMagnify",   "key": "0" },
    { "id": "longshot",      "key": "S" },
    { "id": "ocr",           "key": "O" },
    { "id": "translate",     "key": "T" },
    { "id": "pin",           "key": "P" },
    { "id": "record",        "key": "V" },
    { "id": "lastArea",      "key": "D" },
    { "id": "fullscreen",    "key": "F" },
    { "id": "copyRGB",       "key": "R" },
    { "id": "copyHEX",       "key": "H" },
    { "id": "copyCustom",    "key": "C" },
    { "id": "toggleToolbar", "key": "Tab" }
  ],
  "captureFixed": [
    { "id": "done",          "key": "Enter", "note": "按 save.enterAction 执行（默认复制）" },
    { "id": "cancel",        "key": "Esc" },
    { "id": "copy",          "mac": "cmd+C", "win": "ctrl+C" },
    { "id": "save",          "mac": "cmd+S", "win": "ctrl+S" },
    { "id": "undo",          "mac": "cmd+Z", "win": "ctrl+Z" },
    { "id": "redo",          "mac": "cmd+shift+Z", "win": "ctrl+Y" },
    { "id": "deleteShape",   "key": "Delete", "note": "Mac 的 Backspace 等同 Delete" },
    { "id": "nudge",         "key": "Up/Down/Left/Right", "note": "移动选区 1 像素；按住 Shift 改为调整右/下边；按住 alt 步长 10" },
    { "id": "multiWindow",   "key": "shift", "note": "按住 Shift 点选多个窗口" },
    { "id": "ratioLock",     "key": "0-9", "note": "只在按住鼠标拖出或拉伸选区时生效：0 自由 1 为 1:1 2 为 4:3 3 为 3:2 4 为 16:9 5 为 16:10 6 为 3:4 7 为 2:3 8 为 9:16 9 为 21:9；松开鼠标后数字键回到选工具" }
  ]
}
