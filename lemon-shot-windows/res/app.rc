#include <windows.h>
#include "resource.h"

1 RT_MANIFEST "app.manifest"

// 应用图标（资源管理器、任务栏、窗口标题栏）：design/icon/export_icons.py 生成
IDI_APP ICON "app.ico"

IDR_BRAND_APP_ICON    RCDATA "../../lemon-shot-core/resources/brand/app-icon.png"
IDR_GLYPH_16          RCDATA "../../lemon-shot-core/resources/brand/glyph-16.png"
IDR_GLYPH_18          RCDATA "../../lemon-shot-core/resources/brand/glyph-18.png"
IDR_GLYPH_20          RCDATA "../../lemon-shot-core/resources/brand/glyph-20.png"
IDR_GLYPH_24          RCDATA "../../lemon-shot-core/resources/brand/glyph-24.png"
IDR_GLYPH_32          RCDATA "../../lemon-shot-core/resources/brand/glyph-32.png"
IDR_GLYPH_36          RCDATA "../../lemon-shot-core/resources/brand/glyph-36.png"
IDR_GLYPH_40          RCDATA "../../lemon-shot-core/resources/brand/glyph-40.png"
IDR_GLYPH_48          RCDATA "../../lemon-shot-core/resources/brand/glyph-48.png"

// 共用资源：编进 exe，运行时 FindResource 读取（见 src/Resources）
IDR_SETTINGS_DEFAULTS RCDATA "../../lemon-shot-core/resources/settings.defaults.json"
IDR_SHORTCUTS         RCDATA "../../lemon-shot-core/resources/shortcuts.json"
IDR_TOKENS            RCDATA "../../lemon-shot-core/resources/tokens.json"
IDR_ICONS             RCDATA "../../lemon-shot-core/resources/icons.json"
IDR_I18N_ZH_HANS      RCDATA "../../lemon-shot-core/resources/i18n/zh-Hans.json"
IDR_I18N_EN           RCDATA "../../lemon-shot-core/resources/i18n/en.json"

// 文字识别模型与字典（spec 4，约 10.6 MB）：运行时 FindResource 后交给 ls_ocr_create
IDR_OCR_DET_PARAM     RCDATA "../../lemon-shot-core/third_party/ppocr/PP_OCRv5_mobile_det.ncnn.param"
IDR_OCR_DET_BIN       RCDATA "../../lemon-shot-core/third_party/ppocr/PP_OCRv5_mobile_det.ncnn.bin"
IDR_OCR_REC_PARAM     RCDATA "../../lemon-shot-core/third_party/ppocr/PP_OCRv5_mobile_rec.ncnn.param"
IDR_OCR_REC_BIN       RCDATA "../../lemon-shot-core/third_party/ppocr/PP_OCRv5_mobile_rec.ncnn.bin"
IDR_OCR_DICT          RCDATA "../../lemon-shot-core/third_party/ppocr/ppocrv5_dict.txt"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "LemonIT.CN"
      VALUE "FileDescription", "LemonShot"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "LemonShot"
      VALUE "LegalCopyright", "Copyright (c) 2026 LemonIT.CN, MIT License"
      VALUE "OriginalFilename", "LemonShot.exe"
      VALUE "ProductName", "LemonShot"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
